{
  "name": "deployment branches",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/master",
        "refs/heads/develop"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "creation"
    },
    {
      "type": "update"
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 8667051,
      "actor_type": "Team",
      "bypass_mode": "always"
    },
    {
      "actor_id": 2740,
      "actor_type": "Integration",
      "bypass_mode": "pull_request"
    }
  ]
}
