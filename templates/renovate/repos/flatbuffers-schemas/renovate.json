{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>OpenShock/org-config//renovate/default", "local>OpenShock/org-config//renovate/automerge"],
  "packageRules": [
    {
      "description": "FlatSharp compiler and runtime must be the same version, and a bump changes generated code",
      "matchPackageNames": ["FlatSharp.**"],
      "groupName": "flatsharp",
      "automerge": false
    }
  ]
}
